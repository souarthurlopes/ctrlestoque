{
  "name": "estoqai",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-worker.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:worker": "wrangler deploy --dry-run --outdir dist/worker-check",
    "test": "npm run build && node tests/worker.test.mjs && node tests/obras.cjs && node tests/models.cjs && node tests/importacao.cjs && node tests/estoque.cjs && npm run test:runtime",
    "test:runtime": "npm run check:worker && node tests/worker-runtime.test.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20261023.2-beta",
    "wrangler": "4.155.0"
  }
}
